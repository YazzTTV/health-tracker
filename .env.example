# GitHub JSON source of truth
GITHUB_TOKEN=github_pat_xxx
GITHUB_OWNER=noah
GITHUB_REPO=health-tracker
GITHUB_BRANCH=main
GITHUB_DATA_DIR=data

# Scheduled task protection
TASK_SECRET=replace-with-long-random-secret

# Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Local API development only. Set true with `npm run dev:api` to write JSON files in ./data.
ALLOW_LOCAL_WRITES=true
